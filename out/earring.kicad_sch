	(text "Press: BTN_N -> GND pulls LATCH_G low through D4 A2, Q4 turns on," (at 601.96 271.42 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "36c4c37a-c20b-5e25-bd1c-e0cf16fcae7f"))
	(text "SW_ON = VBATT enables the LDO through D2. The CPU then drives" (at 601.96 274.08 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "f58c7f12-bc9b-55ac-98bf-4da265d8c8d7"))
	(text "PWR_HOLD high so Q5 keeps LATCH_G low after release. Long press:" (at 601.96 276.74 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "1372a287-2cb9-52cf-b183-705fbef5d136"))
	(text "firmware drops PWR_HOLD and power falls when the button is" (at 601.96 279.4 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "b412aae5-16b4-5cff-894d-01bdebbf48c8"))
	(text "released. D4 A1 pulls PRESS_N low while pressed (the one-button" (at 601.96 282.06 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "75ccc5b4-6645-5c62-9185-ddacc8e9c17b"))
	(text "block turns that into BTN_SENSE). With the board off BTN_N sits" (at 601.96 284.72 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "a0ad3194-b463-5fe3-b1e6-41d41145b95c"))
	(text "near VBATT and PRESS_N at 0V, so A1 is reverse-biased. D4 is" (at 601.96 287.38 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "f3404c43-ec4a-5782-8e40-131d07c8bfad"))
	(text "SILICON (BAV70W), not Schottky: the off-state leaks x R24 must" (at 601.96 290.04 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "be0830a8-b908-53fc-bfef-c28b01467bad"))
	(text "stay under Q4's 0.45V minimum threshold even hot. ESD: D6 clamps" (at 601.96 292.7 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "51e8b102-a995-5b17-9c6d-7b1fbc8fdb0d"))
	(text "a strike at the pad and R30 keeps it off BTN_N/D4; C27 debounces." (at 601.96 295.36 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "9576992a-c8d1-58b1-ad73-dae43a064f1c"))
	(polyline (pts (xy 587.84 188.16) (xy 683.54 188.16) (xy 683.54 300.36) (xy 587.84 300.36) (xy 587.84 188.16))
		(stroke (width 0.1524) (type dash))
		(uuid "2d365488-46dc-5d86-b1ab-05274a811e18"))
	(text "power button + soft latch" (at 589.11 186.56 0)
