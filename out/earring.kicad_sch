	(text "CHRG and DONE both release at termination, so they cannot tell 'unplugged' from 'plugged in and" (at 595.0 147.41 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "64a053dd-5dff-54a9-9559-753e5c2d94ce"))
	(text "full'. 10k:10k, not the 100k/1M used elsewhere: PWR_EN backfeeds through R18 and would float" (at 595.0 150.07 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "ec9b93c5-0ba6-55d0-92ce-3bb693758ed3"))
	(text "this node high, so the tap has to be stiff enough to swamp it (0.33V no cable, 2.2-2.75V with" (at 595.0 152.73 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "e5084c42-1f2a-5bf1-b028-eb083d77e3dd"))
	(text "one). That is also what holds Q2's gate low enough to keep the battery path on." (at 595.0 155.39 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "2a42779c-1a60-565b-8971-75653578cdbf"))
	(polyline (pts (xy 590.0 100.98) (xy 695.76 100.98) (xy 695.76 160.39) (xy 590.0 160.39) (xy 590.0 100.98))
