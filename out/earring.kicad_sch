	(global_label "RUN" (shape input) (at 881.92 243.48 0)
		(effects (font (size 1.0 1.0)) (justify left))
		(uuid "447de71c-3fd6-5e6d-bc6a-f6d992d5d8e4"))
	(text "Hold the power button: BTN_SENSE goes high (Q8), C75 charges through R28 and U8 trips 2.2-10.3s later (5s typ; spread" (at 732.06 277.77 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "1d3851ca-6719-55d8-a99e-7b454626d238"))
	(text "is U8's VT+ and C75's X5R tolerance/bias, simulated in design/sim/button). LONG straps QSPI_SS low through Q7/R3 for as" (at 732.06 280.43 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "aa319e57-cbb3-5151-b187-6695fc728c33"))
	(text "long as the button is held and kicks RUN low for ~10ms (C76/R29 -> Q6): the chip resets into BOOTSEL. Flash is not" (at 732.06 283.09 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "bcd08100-2421-5808-a519-84419d0e8877"))
	(text "touched. On battery the reset drops PWR_HOLD, so the board turns off on release: the force-off for hung firmware. D5" (at 732.06 285.75 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "8a38ea2d-b836-540b-8b09-d90421a11486"))
	(text "empties C75 on release. Firmware: GPIO21 no pull-up, high = held; long-press-off < 2s." (at 732.06 288.41 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "c880f456-9eb7-5183-83e3-41b4392ef53a"))
	(polyline (pts (xy 727.06 190.7) (xy 887.3 190.7) (xy 887.3 293.41) (xy 727.06 293.41) (xy 727.06 190.7))
		(stroke (width 0.1524) (type dash))
		(uuid "281b4b8f-c8b6-5480-8546-960a3abecad8"))
	(text "one button: long hold = BOOTSEL / force-off" (at 728.33 189.1 0)
		(effects (font (size 2.2 2.2) (bold yes)) (justify left bottom))
		(uuid "5df6381b-a23e-5988-8699-d899c7bfa61d"))
