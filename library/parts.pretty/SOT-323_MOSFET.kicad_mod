(module SOT-323_BAT54SW (layer F.Cu) (tedit 5DC5F6A4)
	(descr "Generic SOT-323/SC-70 3-lead MOSFET. Land + courtyard reused verbatim from SOT-323_BAT54SW (same JEDEC package, easyeda2kicad vendor land for C78606) so the placement scans that proved SC-70 fits this board still apply. Pin 1 = gate, 2 = source, 3 = drain — the universal 3-lead SOT-23/SOT-323 MOSFET convention, confirmed for CJ2101 (P-ch) and BSS138W (N-ch).")
	(attr smd)
	(fp_text reference REF** (at 0.000 -2.100) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value BAT54SW (at 0.000 2.100) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "LCSC Part" "C78606")
	(fp_line (start -0.70 1.10) (end -0.70 0.63) (layer F.SilkS) (width 0.25))
	(fp_line (start -0.70 -1.10) (end 0.10 -1.10) (layer F.SilkS) (width 0.25))
	(fp_line (start -0.70 1.10) (end 0.10 1.10) (layer F.SilkS) (width 0.25))
	(fp_line (start -0.70 -0.63) (end -0.70 -1.10) (layer F.SilkS) (width 0.25))
	(pad 3 smd rect (at -0.80 0.00 90.00) (size 0.800 0.900) (layers F.Cu F.Paste F.Mask))
	(pad 2 smd rect (at 0.80 -0.65 90.00) (size 0.800 0.900) (layers F.Cu F.Paste F.Mask))
	(pad 1 smd rect (at 0.80 0.65 90.00) (size 0.800 0.900) (layers F.Cu F.Paste F.Mask))
	(fp_circle (center 1.05 1.00) (end 1.08 1.00) (layer F.SilkS) (width 0.06))
	(fp_line (start 1.35 1.20) (end -1.35 1.20) (layer F.CrtYd) (width 0.05))
	(fp_line (start -1.35 1.20) (end -1.35 -1.20) (layer F.CrtYd) (width 0.05))
	(fp_line (start -1.35 -1.20) (end 1.35 -1.20) (layer F.CrtYd) (width 0.05))
	(fp_line (start 1.35 -1.20) (end 1.35 1.20) (layer F.CrtYd) (width 0.05))
	(model "${KIPRJMOD}/../../../library/3d/ee.3dshapes/SOT-323_L2.0-W1.3-H1.0-LS2.1-P1.30.wrl"
		(offset (xyz 0.000 0.000 0.000))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 270))
	)
)
