(footprint "SW_B3U-3000P"
  (version 20240108) (generator gen_footprints)
  (layer "F.Cu")
  (descr "Omron B3U-3000P side-actuated tact switch, LCSC C963349. Actuator toward -y, overhangs the board edge. Pads per Omron PCB pad drawing (4.2/2.6 span, 1.7 tall).")
  (tags "switch tactile side B3U")
  (attr smd)
  (fp_text reference "REF**" (at 0 0) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (fp_text value "B3U-3000P" (at 0 0.8) (layer "F.Fab") (effects (font (size 0.4 0.4) (thickness 0.06))))
  (fp_rect (start -1.5 -1.25) (end 1.5 1.25) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
  (fp_rect (start -0.85 -1.95) (end 0.85 -1.25) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
  (fp_rect (start -2.35 -1.25) (end 2.35 1.5) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (pad "1" smd rect (at 1.7 0) (size 0.8 1.7) (layers "F.Cu" "F.Mask" "F.Paste"))
  (pad "2" smd rect (at -1.7 0) (size 0.8 1.7) (layers "F.Cu" "F.Mask" "F.Paste"))
  (model "${KICAD9_3DMODEL_DIR}/Button_Switch_SMD.3dshapes/SW_SPST_B3U-3000P.step"
